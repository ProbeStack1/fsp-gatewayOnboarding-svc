{
  "info": {
    "name": "Onboarding Service - API Tests",
    "_postman_id": "b4fd5c1b-6c8c-4cf3-9e55-2a5c1c5d2d8c",
    "description": "Collection to test fsp-onboarding-svc onboarding APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Create Application (POST /api/applications)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"targetEmail\": \"target@example.com\",\n  \"stakeholder\": {\n    \"owner\": \"Owner Name\",\n    \"ownerEmail\": \"owner@example.com\",\n    \"sme\": \"SME Name\",\n    \"smeEmail\": \"sme@example.com\",\n    \"dlEmail\": \"dl@example.com\",\n    \"goLiveDate\": \"2026-12-31\"\n  },\n  \"organizations\": [\n    {\n      \"id\": \"org-1\",\n      \"orgName\": \"Organization 1\",\n      \"websiteUrl\": \"https://example.org\",\n      \"region\": \"us-east1\",\n      \"gatewayConfig\": {\n        \"environment\": [\"prod\"],\n        \"expectedTps\": \"1000\",\n        \"expectedApiRange\": \"API-START..API-END\",\n        \"notes\": \"Gateway notes\"\n      }\n    }\n  ]\n}\n"
        },
        "url": {
          "raw": "{{baseUrl}}/api/applications",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "applications"
          ]
        }
      }
    },
    {
      "name": "Submit Approval for Application (POST /api/applications/{id}/submit-approval)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}\n"
        },
        "url": {
          "raw": "{{baseUrl}}/api/applications/{{applicationId}}/submit-approval",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "applications",
            "{{applicationId}}",
            "submit-approval"
          ]
        }
      }
    },
    {
      "name": "Get Application by Id (GET /api/applications/{id})",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/applications/{{applicationId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "applications",
            "{{applicationId}}"
          ]
        }
      }
    },
    {
      "name": "Confirm Approval (GET /api/approval/confirm?token={token}&decision={decision})",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/approval/confirm?token={{approvalToken}}&decision={{decision}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "approval",
            "confirm"
          ],
          "query": [
            {
              "key": "token",
              "value": "{{approvalToken}}"
            },
            {
              "key": "decision",
              "value": "{{decision}}"
            }
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081/onboarding"
    },
    {
      "key": "applicationId",
      "value": "REPLACE_ME"
    },
    {
      "key": "approvalToken",
      "value": "REPLACE_ME"
    },
    {
      "key": "decision",
      "value": "APPROVED"
    }
  ]
}

